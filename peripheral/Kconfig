mainmenu "PAwR peripheral sensor node"

config APP_NODE_ID
	int "This node's human-readable ID, stamped into its reported payload (1-100)"
	default 1
	range 1 100
	help
	  Does NOT determine subevent/slot assignment (central assigns that
	  dynamically over GATT) -- this is only a label so central's printed
	  output and logs are self-describing per physical node.

config APP_CENTRAL_ID
	int "ID of the central this peripheral should pair with (0 = any/default)"
	default 0
	range 0 999
	help
	  Appended as a suffix to the advertised device name (see
	  PAWR_ADV_NAME/pawr_format_adv_name() in common/pawr_protocol.h), so
	  this peripheral is only found by a central with a matching
	  CONFIG_APP_CENTRAL_ID -- lets multiple independent central+
	  peripheral-fleet rigs run in BLE range of each other without
	  cross-onboarding. 0 means "unscoped": advertises under the bare
	  PAWR_ADV_NAME with no suffix, matching a central that also has
	  CONFIG_APP_CENTRAL_ID=0 (the default, preserves old single-central
	  behavior with no config changes needed).

config APP_SIMULATE_SENSORS
	bool "Use simulated sensor values instead of real I2C reads"
	default n
	help
	  When enabled, skips real sensor init/reads and reports slowly
	  drifting fake temperature/humidity values instead. Useful for
	  exercising the PAwR protocol path without I2C hardware attached.

config APP_SERIAL_LOGGING
	bool "Enable diagnostic printk() output over the serial console"
	default y
	help
	  Disable for real unattended field deployment to avoid any chance of
	  the serial console -- a USB-CDC transport already shown fragile
	  under load this session (see the "udc: Failed to allocate net_buf"
	  and CONFIG_SHELL boot hangs in NOTES.md) -- being a source of
	  problems. Does not affect BLE/PAwR behavior or on-board flash
	  logging, only the printk() diagnostic messages. See APP_LOG() in
	  main.c.

config APP_DUMP_ON_BOOT
	bool "Dump the on-board flash sensor log as CSV over serial at boot"
	default n
	help
	  One-shot retrieval mode: at boot, print every reading stored in the
	  on-board flash log (see storage_fcb_* in main.c) as CSV over the
	  plain printk() console, then continue normal PAwR operation as
	  usual. Build with this set, flash the specific physical board whose
	  log you want, and capture its serial output right after boot
	  (tools/Watch-SerialLog.ps1) -- the CSV is between the header row and
	  the trailing "# N rows" line. Replaces the earlier shell-based
	  "dump" command, which hung the board's console (see NOTES.md
	  2026-08-03).

source "Kconfig.zephyr"
