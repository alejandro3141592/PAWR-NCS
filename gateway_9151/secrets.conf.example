# Copy this file to secrets.conf (gitignored -- never commit real
# credentials) and fill in the real values, then build with:
#
#   & $python -m west build --build-dir gateway_9151/build gateway_9151 --pristine \
#       --board nrf9151dk/nrf9151/ns -- -DEXTRA_CONF_FILE=secrets.conf
#
# See BUILD_AND_FLASH.md for the full copy-paste build command including the
# toolchain environment setup.

CONFIG_APP_MQTT_BROKER_HOSTNAME="9bfedb3b92a849fb856339994755a836.s1.eu.hivemq.cloud"
CONFIG_APP_MQTT_BROKER_PORT=8883
CONFIG_APP_MQTT_USE_TLS=y
CONFIG_APP_MQTT_USERNAME="test_username"
CONFIG_APP_MQTT_PASSWORD="REPLACE_WITH_REAL_PASSWORD"

# REQUIRED, and must be different on every physical gateway board -- two
# gateways connecting to the same broker with the same client ID make the
# broker forcibly disconnect each other on every (re)connect. There's no
# built-in default (see gateway_9151/Kconfig); the firmware panics at boot
# if this is left unset. Suggested convention: match the suffix to this
# gateway's paired central's CONFIG_APP_CENTRAL_ID, e.g. gateway for
# central 3 -> "pawr-gateway-9151-3". See NOTES.md 2026-08-08.
CONFIG_APP_MQTT_CLIENT_ID="pawr-gateway-9151-REPLACE_WITH_CENTRAL_ID"
