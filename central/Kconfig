mainmenu "PAwR central hub"

config APP_CENTRAL_ID
	int "This central's ID (0 = default/unscoped)"
	default 0
	range 0 999
	help
	  Only peripherals advertising a matching CONFIG_APP_CENTRAL_ID suffix
	  (see PAWR_ADV_NAME/pawr_format_adv_name() in common/pawr_protocol.h)
	  will be onboarded by this central -- lets multiple independent
	  central+peripheral-fleet rigs run in BLE range of each other without
	  cross-onboarding each other's peripherals. 0 means "unscoped": scans
	  for the bare PAWR_ADV_NAME with no suffix, matching peripherals that
	  also have CONFIG_APP_CENTRAL_ID=0 (the default, preserves old
	  single-central behavior with no config changes needed).

config APP_ACCEPT_ANY_NODE
	bool "Onboard any advertising peripheral, ignoring node_slot_table.h"
	default n
	help
	  Temporary hardware bring-up/triage mode: instead of refusing
	  peripherals with no node_slot_table.h entry, assign each one the
	  next free subevent (single slot, no primary/backup redundancy) in
	  the order they're seen. For testing which physical nodes out of a
	  larger pool actually power on and report correctly, one at a time,
	  before they're added to the real table. Not for normal/production
	  use -- leave off so unlisted nodes are refused as intended.

config APP_DUMP_LOG_ON_BOOT
	bool "Dump the on-board flash sensor log as CSV over serial at boot"
	default n
	help
	  One-shot retrieval mode: at boot, print every payload recorded in
	  the on-board flash log (see common/sensor_log.h) as CSV over
	  printk(), then continue normal operation as usual. Same mechanism
	  as peripheral's CONFIG_APP_DUMP_ON_BOOT -- capture serial output
	  right after boot to retrieve the CSV.

source "Kconfig.zephyr"
