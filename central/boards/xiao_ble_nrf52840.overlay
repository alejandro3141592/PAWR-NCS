/*
 * Enables the XIAO BLE's second UART controller (uart1) for the wired link
 * to the nRF9151 gateway board -- separate from uart0/xiao_serial, which is
 * this board's console (routed to USB-CDC-ACM; see zephyr.dts
 * zephyr,console = &board_cdc_acm_uart) and physically occupies D6/D7
 * (P1.11/P1.12, per xiao_ble-pinctrl.dtsi's uart0_default). D4/D5 are
 * already committed to the I2C sensor bus (see peripheral's overlay). That
 * leaves D8/D9 (P1.13/P1.14) as the first free pin pair -- used here for
 * uart1 TX/RX.
 *
 * Wiring: XIAO D8 (TX) -> 9151 DK UART RX, XIAO D9 (RX) -> 9151 DK UART TX,
 * plus a shared GND between the two boards. Confirm the 9151 DK's chosen
 * UART instance/pins against its own overlay (gateway_9151/boards/) once
 * that's written -- the two ends must agree on which physical pins carry
 * TX vs RX (they cross over) and use the same baud rate (see
 * CONFIG_APP_UART_BAUDRATE in gateway_9151/Kconfig, default 115200).
 */

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RX, 1, 14)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 13)>,
				<NRF_PSEL(UART_RX, 1, 14)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};

/ {
	aliases {
		gateway-uart = &uart1;
	};
};
