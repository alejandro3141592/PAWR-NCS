# west/CMake build output (regenerated by `west build`)
build/
build2/
*/build/
*/build_node*/
*/build_incremental/

# PlatformIO build output (broadcasting/ -- regenerated by `pio run`)
*/.pio/
*/build_hub/

# One-off build<suffix>/ dirs from ad hoc multi-rig/multi-node test builds
# (e.g. build_central2, build_dump33, build55, build3) -- regenerated by
# `west build -d <dir>`, not meant to be tracked. See acb7ac8 for the
# original build-dir gitignore fix; this covers the wider set of suffixes
# seen since.
*/build_*/
*/build[0-9]*/

# CMake / Ninja stray files if ever configured outside build/
CMakeCache.txt
CMakeFiles/
compile_commands.json

# Editor/OS cruft
.vscode/
*.user
Thumbs.db
.DS_Store

# Local per-board identity, not shared project content -- each physical
# peripheral board has its own node_id.txt, not something to sync/overwrite
# via git when multiple people/boards use this same checkout.
peripheral/node_id.txt

# MQTT broker credentials -- real values only ever go in this local,
# untracked copy. gateway_9151/secrets.conf.example (committed) is the
# template to copy from.
gateway_9151/secrets.conf

# Scratch Kconfig fragment for the UART loopback diagnostic build (see
# BUILD_AND_FLASH.md) -- created/removed locally as needed, not committed.
gateway_9151/boards/loopback_test.conf

# GUI broker credentials -- real values only ever go in this local,
# untracked copy. gui/config.example.json (committed) is the template.
gui/config.json

# GUI runtime data: local SQLite DB + any exported CSVs, not shared project
# content.
gui/sensor_data.db
gui/sensor_data.db-*
gui/node_manager.db
gui/node_manager.db-*
gui/*.csv
gui/exports/
*.png

# Stray root-level exports from ad hoc GUI use (e.g.
# multi_person_export_<timestamp>.csv) -- personal data snapshots, not
# tracked source. Scoped to this specific naming pattern (not a blanket
# *.csv) so a real, intentionally-committed CSV elsewhere in the repo
# (e.g. tools/node_roster.csv) isn't accidentally caught.
/multi_person_export_*.csv

# Staged flashable build artifacts (2026-08-13) -- output copies of
# already-built .uf2/.hex files under builds/latest and builds/extraction,
# regenerable from source via the commands in BUILD_AND_FLASH.md. Not
# tracked to avoid binary bloat in history; the folder structure itself
# (and how to regenerate its contents) is documented there.
builds/

# PyInstaller packaging output for the GUI (see 47dde2c) -- regenerated by
# the packaging build, not shared project content.
gui/dist/
gui/build/
gui/*.spec

# Serial captures, soak-test logs, and flash-log dumps from real hardware
# runs -- local test artifacts, not shared project content.
logs/

# Python bytecode cache
__pycache__/
*.pyc

# Claude Code local session state, not shared project content
.claude/

# Legacy Arduino/Bluefruit broadcast reference, superseded by central/peripheral
# (different BLE stack, kept locally for reference only, not part of this repo)
lib/
